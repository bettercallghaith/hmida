# ===========================================
# WhatsApp MCP Infrastructure Platform
# Environment Configuration
# ===========================================

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=whatsapp_mcp
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# External Ports (exposed to host)
# Change these to avoid conflicts
# ===========================================
POSTGRES_EXTERNAL_PORT=5433
REDIS_EXTERNAL_PORT=6380
WHATSAPP_ENGINE_PORT=3456
API_GATEWAY_PORT=8765
MCP_SERVER_PORT=8766

# API Gateway
API_SECRET_KEY=generate_a_secure_random_string_here
API_DEBUG=false

# MCP Server
MCP_API_KEY=internal_service_key_change_me

# Webhook Configuration
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_SECONDS=1

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
